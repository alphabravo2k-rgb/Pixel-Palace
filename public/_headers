# -------------------------------------------------------------------
# 🛡️ PIXEL PALACE: GLOBAL HEADERS (SECURITY & CACHING)
# -------------------------------------------------------------------

# 1. GLOBAL SECURITY (Applies to all paths)
/*
  X-Frame-Options: DENY
  X-XSS-Protection: 1; mode=block
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), microphone=(), camera=(), payment=()
  
  # ✅ FIXED CSP: Explicitly allows your specific Supabase Project URL
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://*.supabase.co https://raw.githubusercontent.com; media-src 'self' data: blob: https://*.supabase.co; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://mbejyfwiuphpktospkga.supabase.co wss://mbejyfwiuphpktospkga.supabase.co; worker-src 'self' blob:;

# 2. APP ENTRY POINT (Never Cache)
/index.html
  Cache-Control: no-cache, no-store, must-revalidate

# 3. STATIC ASSETS (Cache Forever)
/assets/*
  Cache-Control: public, max-age=31536000, immutable
