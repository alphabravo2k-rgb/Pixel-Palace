# -------------------------------------------------------------------
# 🛡️ PIXEL PALACE: REPOSITORY SHIELD (GLOBAL STANDARD)
# -------------------------------------------------------------------

# 📦 DEPENDENCIES
node_modules/
.pnp
.pnp.js

# 🏗️ BUILD ARTIFACTS
dist/
dist-ssr/
dev-dist/
build/
out/
*.local

# 📊 ANALYTICS JUNK
# We don't want to commit the build analysis charts
stats.html
bundle-stats.html
coverage/
.nyc_output/

# 🔐 SECURITY VAULT (CRITICAL)
# Never commit your secrets.
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert

# ✅ EXCEPTION: Commit the template so devs know what keys they need
!.env.example

# ⚡ VITE & PERFORMANCE CACHES
.vite/
.eslintcache
.prettiercache
.stylelintcache
.cache/
.parcel-cache

# ⚡ SUPABASE & BACKEND
supabase/.branches/
supabase/.temp/
supabase/functions/.import_map.json
supabase/tmp/

# 🛠️ IDE SETTINGS (Personal preferences should stay local)
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# 🖥️ OS TRASH FILES
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Icon?

# ☁️ CLOUD PLATFORMS
.vercel
.wrangler
.turbo
.netlify

# 📝 LOGS
logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
