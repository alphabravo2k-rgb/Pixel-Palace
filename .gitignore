# -------------------------------------------------------------------
# 🛰️ NEXUS CORE: REPOSITORY SHIELD
# VERSION: 2050.1.0 (MASTER OMNI)
# STATUS: SECURED
# -------------------------------------------------------------------

# 📦 DEPENDENCIES & KERNEL CACHE
node_modules/
.pnp
.pnp.js
.vite/
.eslintcache
.prettiercache
.turbo/
.cache/

# 🏗️ BUILD ARTIFACTS (STAGING & PRODUCTION)
dist/
dist-ssr/
build/
out/
dist_stats.html
bundle-stats.html
stats.html

# 🔐 SECURITY VAULT (NON-NEGOTIABLE)
# Ensures your Supabase Keys & SSL Certs stay off the public net
.env
.env.*
!.env.example
*.pem
*.key
*.cert
secrets.json

# 🛠️ IDE & WORKSPACE (INDIVIDUAL OVERRIDES)
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo

# 🖥️ OS & SYSTEM TRASH
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db

# 🎮 TOURNAMENT HARD-FILES & 3D ASSETS
# We ignore raw heavy media to keep Git operations at 0ms latency.
# Use Supabase Storage for these, never Git.
public/assets/raw-3d/
public/assets/audio-stems/
*.mp4
*.dem
*.mov
*.glb
*.gltf
*.obj

# ⚡ SUPABASE LOCAL DEV
supabase/.branches/
supabase/.temp/
supabase/functions/.import_map.json
supabase/tmp/

# ☁️ CLOUD PLATFORM ARTIFACTS
.vercel
.netlify
.wrangler
.turbo

# 📝 LOGS & TELEMETRY
logs
*.log
npm-debug.log*
yarn-debug.log*
