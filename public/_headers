# -------------------------------------------------------------------
# 🛡️ PIXEL PALACE: GLOBAL HEADERS (SECURITY & CACHING)
# -------------------------------------------------------------------

# 1. GLOBAL SECURITY (Applies to all paths)
/*
  X-Frame-Options: DENY
  X-XSS-Protection: 1; mode=block
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), microphone=(), camera=(), payment=()
  # CSP: Permissive for Phase 1 (Supabase/3rd Party Support). Tighten in Phase 2.
  Content-Security-Policy: default-src * data: blob: 'unsafe-inline' 'unsafe-eval'; script-src * 'unsafe-inline' 'unsafe-eval'; connect-src * 'unsafe-inline' wss:; img-src * data: blob: 'unsafe-inline'; style-src * 'unsafe-inline';

# 2. APP ENTRY POINT (Never Cache)
# Ensures users always get the latest deployment immediately.
/index.html
  Cache-Control: no-cache, no-store, must-revalidate

# 3. STATIC ASSETS (Cache Forever)
# Vite handles cache-busting via filenames (e.g. index-a1b2.js), so we cache these aggressively.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
